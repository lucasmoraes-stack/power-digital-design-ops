{#- M24 Footer (T18 / L25). 600 x 587: navy block 455.5 (#295791, x 0.5) + legal bar 131.5 (#24436F). All text Gotham, white, centered. -#}
<footer class="m ftr" data-module="M24" data-wrapper="footer" style="height:{{ m.h|px }}">
<div class="lay" data-layer="block" style="left:{{ m.block_x|px }};top:0;width:{{ (600 - m.block_x)|px }};height:{{ m.block_h|px }};background:{{ m.block_color }}"></div>
<div class="lay" data-layer="legal-bar" style="left:0;top:{{ m.block_h|px }};width:600px;height:{{ (m.h - m.block_h)|px }};background:{{ m.bar_color }}"></div>
{%- if m.disclaimer %}
<p class="t r-disclaimer lay" data-layer="disclaimer" style="left:{{ m.disclaimer_x|px }};top:{{ m.disclaimer_y|px }};width:{{ m.disclaimer_w|px }};text-align:center;color:#FFFFFF">{{ m.disclaimer }}</p>
{%- endif %}
<p class="t r-foot lay" data-layer="natural-link" style="left:64.4px;top:{{ m.link_y|px }};width:471.6px;text-align:center;text-decoration:underline;text-decoration-thickness:{{ m.underline_w|px }};text-underline-offset:{{ m.underline_offset|px }}">{{ m.link_text }}</p>
<div class="lay" data-layer="logo" style="left:249.8px;top:{{ m.logo_y|px }};width:101.4px;height:82px"><img src="{{ m.logo|img }}" alt="Tom's of Maine" style="width:100%;height:100%"></div>
<div class="lay" data-layer="social" style="left:220.3px;top:{{ m.social_y|px }};width:160px;height:32px;display:flex">
{%- for ic in m.social %}<div style="width:32px;height:32px;flex:none"><img src="{{ ic|img }}" alt="" style="width:32px;height:32px"></div>{% endfor %}</div>
<div class="lay" data-layer="nav" style="left:64.4px;top:{{ m.nav_y|px }};width:471.6px">
{%- for n in m.nav %}<p class="t r-foot" style="line-height:{{ m.nav_line|px }};text-align:center">{{ n }}</p>{% endfor %}</div>
{%- for line in m.legal %}
<p class="t r-legal lay" data-layer="legal-{{ loop.index }}" style="left:32.5px;top:{{ line.y|px }};width:535.6px;text-align:center">{{ line.text }}</p>
{%- endfor %}
</footer>
