# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*~
node_modules/

# licensed font binaries — keep locally, never redistribute
*.otf
*.ttf
*.woff
*.woff2

# python
__pycache__/
*.pyc

# brand image bank originals (heavy; kept on disk/OneDrive, crops used by the kit live in email-kit/assets/)
clients/*/01-brand/photos/**/*.png
clients/*/01-brand/photos/**/*.jpg
clients/*/01-brand/photos/**/*.jpeg
clients/*/03-work/**/_src/

# client-confidential source material (kept on disk/OneDrive, never in the public repo)
clients/habit-outdoors/01-brand/identity/*.pdf
clients/*/01-brand/email-kit/references/*.png
clients/*/01-brand/email-kit/references/*.html
clients/*/01-brand/email-kit/references/*_files/
__pycache__/

# raw dumps of sent emails received from clients (heavy + confidential; kept on disk/OneDrive)
clients/*/00-inbox/emails-enviados/**
!clients/*/00-inbox/emails-enviados/README.md
clients/*/00-inbox/refs-html/**
!clients/*/00-inbox/refs-html/README.md

# raw Figma image originals pulled for email kits (heavy; kept on disk/OneDrive)
clients/*/01-brand/email-kit/assets/source/

# saved third-party web pages used as email references (heavy; kept on disk/OneDrive)
clients/*/03-work/email/*/references/*.html
clients/*/03-work/email/*/references/*_files/
